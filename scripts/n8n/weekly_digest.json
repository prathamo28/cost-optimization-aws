{
  "name": "Weekly cost digest",
  "description": "Runs every Monday at 08:00. Fetches top cost anomalies and Compute Optimizer recommendations, sends to Claude, posts ranked digest to Slack and emails PDF to leadership.",
  "nodes": [
    {
      "id": "1",
      "name": "Cron trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [200, 300],
      "parameters": {
        "rule": {
          "interval": [{"field": "cronExpression", "expression": "0 8 * * MON"}]
        }
      },
      "notes": "Fires every Monday at 08:00 UTC"
    },
    {
      "id": "2a",
      "name": "Fetch Cost Explorer anomalies",
      "type": "n8n-nodes-base.awsHttpRequest",
      "position": [400, 200],
      "parameters": {
        "service": "ce",
        "action": "GetAnomalies",
        "body": "{\"DateInterval\":{\"StartDate\":\"{{ DateTime.now().minus({days:7}).toFormat('yyyy-MM-dd') }}\",\"EndDate\":\"{{ DateTime.now().toFormat('yyyy-MM-dd') }}\"},\"TotalImpact\":{\"NumericOperator\":\"GREATER_THAN\",\"StartValue\":10},\"MaxResults\":20}"
      },
      "notes": "Top anomalies from the past 7 days with impact > $10"
    },
    {
      "id": "2b",
      "name": "Fetch Compute Optimizer recs",
      "type": "n8n-nodes-base.awsHttpRequest",
      "position": [400, 400],
      "parameters": {
        "service": "compute-optimizer",
        "action": "GetEC2InstanceRecommendations",
        "body": "{\"filters\":[{\"name\":\"Finding\",\"values\":[\"OVER_PROVISIONED\"]}]}"
      },
      "notes": "Over-provisioned EC2 instances with rightsizing suggestions"
    },
    {
      "id": "3",
      "name": "Merge data",
      "type": "n8n-nodes-base.merge",
      "position": [600, 300],
      "parameters": {"mode": "mergeByIndex"}
    },
    {
      "id": "4",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [800, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "model",      "value": "claude-sonnet-4-20250514"},
            {"name": "max_tokens", "value": 800},
            {
              "name":  "messages",
              "value": "=[{\"role\":\"user\",\"content\":\"Weekly FinOps digest. Anomalies: \" + JSON.stringify($json.anomalies) + \" Rightsizing: \" + JSON.stringify($json.recommendations) + \". Write a short digest (5-8 sentences) in plain English, then list top 5 ranked actions with estimated saving and risk.\"}]"
            }
          ]
        },
        "options": {
          "headers": {
            "parameters": [
              {"name": "x-api-key",        "value": "={{ $credentials.anthropicApiKey }}"},
              {"name": "anthropic-version", "value": "2023-06-01"}
            ]
          }
        }
      }
    },
    {
      "id": "5",
      "name": "Extract digest text",
      "type": "n8n-nodes-base.code",
      "position": [1000, 300],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const text = $input.first().json.content[0].text;\nconst week = new Date().toISOString().split('T')[0];\nreturn [{ json: { digest: text, week } }];"
      }
    },
    {
      "id": "6a",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "position": [1200, 200],
      "parameters": {
        "operation": "postMessage",
        "channel": "#cost-ops-ai",
        "text": "=*Weekly cost digest — {{ $json.week }}*\n\n{{ $json.digest }}"
      }
    },
    {
      "id": "6b",
      "name": "Send email to leadership",
      "type": "n8n-nodes-base.emailSend",
      "position": [1200, 400],
      "parameters": {
        "toEmail": "leadership@example.com",
        "subject": "=Weekly cloud cost digest — {{ $json.week }}",
        "text":    "={{ $json.digest }}",
        "options": {}
      },
      "notes": "Replace toEmail with actual leadership distribution list"
    }
  ],
  "connections": {
    "Cron trigger":                  {"main": [[{"node": "Fetch Cost Explorer anomalies",  "type": "main", "index": 0}, {"node": "Fetch Compute Optimizer recs", "type": "main", "index": 0}]]},
    "Fetch Cost Explorer anomalies": {"main": [[{"node": "Merge data", "type": "main", "index": 0}]]},
    "Fetch Compute Optimizer recs":  {"main": [[{"node": "Merge data", "type": "main", "index": 1}]]},
    "Merge data":                    {"main": [[{"node": "Call Claude API",      "type": "main", "index": 0}]]},
    "Call Claude API":               {"main": [[{"node": "Extract digest text",  "type": "main", "index": 0}]]},
    "Extract digest text":           {"main": [[{"node": "Post to Slack",        "type": "main", "index": 0}, {"node": "Send email to leadership", "type": "main", "index": 0}]]}
  }
}
