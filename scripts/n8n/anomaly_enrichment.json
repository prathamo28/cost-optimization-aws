{
  "name": "Cost anomaly enrichment",
  "description": "Triggered by AWS SNS when Cost Anomaly Detection fires. Fetches context from CloudWatch, GitHub, and resource tags, sends to Claude API, posts result to Slack and creates a Jira ticket.",
  "nodes": [
    {
      "id": "1",
      "name": "SNS Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [200, 300],
      "parameters": {
        "path": "cost-anomaly-alert",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "notes": "AWS SNS sends a POST to this webhook when an anomaly is detected. Configure the SNS subscription endpoint to point to your n8n instance."
    },
    {
      "id": "2",
      "name": "Parse SNS message",
      "type": "n8n-nodes-base.code",
      "position": [400, 300],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = JSON.parse($input.first().json.body);\nconst message = JSON.parse(body.Message);\nreturn [{ json: {\n  service:        message.anomalyDetails?.service ?? 'unknown',\n  team:           message.anomalyDetails?.resourceTags?.['cost:team'] ?? 'unknown',\n  environment:    message.anomalyDetails?.resourceTags?.['cost:env'] ?? 'unknown',\n  expected_spend: message.impact?.expectedSpend ?? 0,\n  actual_spend:   message.impact?.actualSpend ?? 0,\n  resource_id:    message.anomalyDetails?.resourceId ?? null,\n  period_start:   message.anomalyStartDate,\n  period_end:     message.anomalyEndDate,\n}}];"
      }
    },
    {
      "id": "3a",
      "name": "Fetch CloudWatch metrics",
      "type": "n8n-nodes-base.awsCloudwatch",
      "position": [600, 200],
      "parameters": {
        "operation": "getMetricStatistics",
        "namespace": "AWS/EC2",
        "metricName": "CPUUtilization",
        "dimensionName": "InstanceId",
        "dimensionValue": "={{ $json.resource_id }}",
        "statistics": ["Average"],
        "period": 86400,
        "startTime": "={{ DateTime.now().minus({days: 30}).toISO() }}",
        "endTime": "={{ DateTime.now().toISO() }}"
      }
    },
    {
      "id": "3b",
      "name": "Fetch GitHub deployments",
      "type": "n8n-nodes-base.httpRequest",
      "position": [600, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/your-org/your-app/deployments?environment={{ $json.environment }}&per_page=5",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "headers": {
            "parameters": [{"name": "Accept", "value": "application/vnd.github.v3+json"}]
          }
        }
      }
    },
    {
      "id": "3c",
      "name": "Fetch resource tags",
      "type": "n8n-nodes-base.awsEc2",
      "position": [600, 400],
      "parameters": {
        "operation": "describeTags",
        "filters": [{"name": "resource-id", "value": "={{ $json.resource_id }}"}]
      }
    },
    {
      "id": "4",
      "name": "Merge context",
      "type": "n8n-nodes-base.merge",
      "position": [800, 300],
      "parameters": {
        "mode": "mergeByIndex"
      },
      "notes": "Combines anomaly data, CloudWatch metrics, GitHub deployments, and tags into one payload."
    },
    {
      "id": "5",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1000, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 600
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": \"You are a FinOps engineer. Anomaly: \" + JSON.stringify($json.anomaly) + \" Metrics: \" + JSON.stringify($json.metrics) + \" Deployments: \" + JSON.stringify($json.deployments) + \". Respond in JSON: {finding, root_cause, recommended_action, estimated_monthly_saving_usd, risk_level, validation_step, confidence_pct}\"}]"
            }
          ]
        },
        "options": {
          "headers": {
            "parameters": [
              {"name": "x-api-key",         "value": "={{ $credentials.anthropicApiKey }}"},
              {"name": "anthropic-version",  "value": "2023-06-01"}
            ]
          }
        }
      }
    },
    {
      "id": "6",
      "name": "Parse Claude response",
      "type": "n8n-nodes-base.code",
      "position": [1200, 300],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const text = $input.first().json.content[0].text;\nconst clean = text.replace(/```json|```/g, '').trim();\nconst finding = JSON.parse(clean);\nreturn [{ json: { ...finding, raw_anomaly: $input.first().json.anomaly } }];"
      }
    },
    {
      "id": "7a",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "position": [1400, 200],
      "parameters": {
        "operation": "postMessage",
        "channel": "#cost-ops-ai",
        "text": "=*Cost anomaly — {{ $json.raw_anomaly.team }}/{{ $json.raw_anomaly.environment }}*\n\n*Finding:* {{ $json.finding }}\n*Root cause:* {{ $json.root_cause }}\n*Recommended action:* {{ $json.recommended_action }}\n*Estimated saving:* ${{ $json.estimated_monthly_saving_usd }}/month\n*Risk:* {{ $json.risk_level }}  |  *Confidence:* {{ $json.confidence_pct }}%\n\nReact :white_check_mark: to approve or :x: to reject."
      }
    },
    {
      "id": "7b",
      "name": "Create Jira ticket",
      "type": "n8n-nodes-base.jira",
      "position": [1400, 400],
      "parameters": {
        "operation": "create",
        "project": "COST",
        "issueType": "Task",
        "summary": "=[Cost] {{ $json.raw_anomaly.team }} anomaly — {{ $json.recommended_action.substring(0, 60) }}",
        "description": "=*Finding*\n{{ $json.finding }}\n\n*Root cause*\n{{ $json.root_cause }}\n\n*Action*\n{{ $json.recommended_action }}\n\n*Estimated saving*\n${{ $json.estimated_monthly_saving_usd }}/month\n\n*Validation*\n{{ $json.validation_step }}",
        "priority": "={{ $json.risk_level === 'HIGH' ? 'High' : 'Medium' }}"
      }
    }
  ],
  "connections": {
    "SNS Webhook":            {"main": [[{"node": "Parse SNS message",      "type": "main", "index": 0}]]},
    "Parse SNS message":      {"main": [[{"node": "Fetch CloudWatch metrics","type": "main", "index": 0}, {"node": "Fetch GitHub deployments", "type": "main", "index": 0}, {"node": "Fetch resource tags", "type": "main", "index": 0}]]},
    "Fetch CloudWatch metrics":{"main": [[{"node": "Merge context",          "type": "main", "index": 0}]]},
    "Fetch GitHub deployments":{"main": [[{"node": "Merge context",          "type": "main", "index": 1}]]},
    "Fetch resource tags":    {"main": [[{"node": "Merge context",           "type": "main", "index": 2}]]},
    "Merge context":          {"main": [[{"node": "Call Claude API",         "type": "main", "index": 0}]]},
    "Call Claude API":        {"main": [[{"node": "Parse Claude response",   "type": "main", "index": 0}]]},
    "Parse Claude response":  {"main": [[{"node": "Post to Slack",           "type": "main", "index": 0}, {"node": "Create Jira ticket", "type": "main", "index": 0}]]}
  }
}
